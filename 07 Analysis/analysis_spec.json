{
  "title": "Ola Bengaluru Rides Analysis",
  "source": "05 Cleaning and Prep/Ola_Rides_Analysis_Clean_final.xlsx",
  "data_table": "ola",
  "other_tables": [],
  "helper_columns_script": "07 Analysis/helpers.py",
  "calculated_fields": [
    {
      "name": "Success_Rate",
      "formula": "Is_Completed/Bookings"
    },
    {
      "name": "Avg_Fare",
      "formula": "Revenue/Is_Completed"
    },
    {
      "name": "CustCancel_Rate",
      "formula": "Cust_Cancelled/Bookings"
    },
    {
      "name": "DriverCancel_Rate",
      "formula": "Driver_Cancelled/Bookings"
    },
    {
      "name": "NotFound_Rate",
      "formula": "Not_Found/Bookings"
    },
    {
      "name": "Failure_Rate",
      "formula": "Failed/Bookings"
    }
  ],
  "slicers": [
    "Week_Label",
    "Vehicle_Type",
    "Pickup_Location",
    "Payment_Label"
  ],
  "control_totals": [
    "Booking_Value",
    "Revenue",
    "Bookings",
    "Is_Completed"
  ],
  "notes": [
    "Currency INR. Success = status Success (includes 3,926 flagged incomplete, DQ-05 B). Revenue = completed rides only. Quoted value lost (Q11) is not revenue. Turnaround source unit is seconds (tentative), shown in minutes. No fare-vs-distance or revenue-per-km views (DQ-09 B). Customer_ID is not used. Data covers July 2024 only; week of 29 July has 3 days. Payment slicer: non-completed bookings carry the label 'Not completed (no payment)'. Q8 lists all 50 pickup areas: sort or filter the PivotTable for a top 10."
  ],
  "dashboard": {
    "title": "Ola Bengaluru Rides Dashboard (July 2024)",
    "notes": [
      "Amounts in INR. Revenue = completed rides only."
    ]
  },
